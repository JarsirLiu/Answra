{
  "name": "@answra/agent",
  "version": "0.1.0",
  "private": true,
  "description": "平台无关的 Agent 运行时：会话、模型调用与 worker 线协议。",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:asr:fetch": "node examples/vad-asr-eval/fetch-assets.mjs",
    "eval:asr": "node examples/vad-asr-eval/run-eval.mjs",
    "eval:asr:one": "node examples/vad-asr-eval/fetch-assets.mjs && node examples/vad-asr-eval/run-eval.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.81",
    "@answra/shared": "workspace:*",
    "ai": "6.0.303"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "sherpa-onnx-node": "1.13.8",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
