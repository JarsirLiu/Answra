# ── 环境变量样例 ──────────────────────────────────────────────
# 复制为 .env 使用；.env 不提交到 Git。
# 变量名只允许在 packages/shared/src/env.ts 中定义。

# 应用运行环境：development | production | test（非 secret）
ANSWRA_ENV=development

# 本地 AI 服务（Agent Runtime，AG-UI 协议）基础地址（secret，接入时填写）
ANSWRA_AI_BASE_URL=

# 云端网关地址：默认 https://api.answra.com；仅开发态可覆盖为 http://127.0.0.1:<端口>（非 secret）
ANSWRA_CLOUD_API_BASE_URL=

# 站点地址（浏览器授权页所在站点）：默认 https://answra.com；仅开发态可覆盖为 http://127.0.0.1:<端口>（非 secret）
ANSWRA_CLOUD_SITE_BASE_URL=
