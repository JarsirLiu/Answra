{
  "name": "@answra/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron 桌面壳：main/preload/renderer 三进程，renderer 只做薄壳，业务 UI 在 @answra/ui。",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "pnpm build:electron && concurrently -k \"vite --host 127.0.0.1 --port 5180 --strictPort\" \"wait-on http://127.0.0.1:5180 && electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "pnpm build:electron && vite build",
    "build:electron": "node ./scripts/build-electron.mjs",
    "ime:prepare": "node ./scripts/prepare-rime.mjs",
    "vad:prepare": "node ./scripts/prepare-ten-vad.mjs",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "pnpm build && electron-builder --win nsis"
  },
  "build": {
    "appId": "dev.answra.desktop",
    "productName": "Exam Assistant",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/rime",
        "to": "rime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/vad",
        "to": "vad",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "protocols": [
      {
        "name": "Answra",
        "schemes": [
          "answra"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@answra/shared": "workspace:*",
    "@answra/ui": "workspace:*",
    "koffi": "^3.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@answra/agent": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "29.4.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
