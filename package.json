{
  "name": "answra-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "pnpm --filter @answra/desktop dev",
    "dev:web": "pnpm --filter @answra/desktop dev:web",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "tokens:check": "node scripts/design/check-tokens.mjs",
    "notes:check": "node scripts/docs/check-notes.mjs",
    "notes:hint": "node scripts/docs/check-notes.mjs --warn",
    "docs:check": "pnpm notes:check",
    "verify": "pnpm lint && pnpm notes:hint && pnpm typecheck && pnpm test && pnpm architecture:check",
    "dist:win": "pnpm --filter @answra/desktop dist:win",
    "release:win": "pnpm dist:win && node apps/desktop/scripts/upload-to-cos.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,json,css}": [
      "biome check --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
