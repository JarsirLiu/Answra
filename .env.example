# ── 环境变量样例 ──────────────────────────────────────────────
# 复制为 .env 使用；.env 不提交到 Git。
# 变量名只允许在 packages/shared/src/env.ts 中定义。

# 应用运行环境：development | production | test（非 secret）
EXAM_ASSISTANT_ENV=development

# 本地 AI 服务（Agent Runtime，AG-UI 协议）基础地址（secret，接入时填写）
EXAM_ASSISTANT_AI_BASE_URL=
