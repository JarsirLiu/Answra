{
  "name": "@answra/agent",
  "version": "0.1.0",
  "private": true,
  "description": "平台无关的 Agent 运行时：会话、模型调用与 worker 线协议。",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./evaluation": "./src/interview/evaluation.ts",
    "./grep-worker": "./src/core/tool/builtin/grepWorker.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.81",
    "@answra/shared": "workspace:*",
    "ai": "6.0.303",
    "ripgrep": "0.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
