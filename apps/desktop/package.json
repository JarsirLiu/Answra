{
  "name": "@answra/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron 桌面壳：main/preload/renderer 三进程，renderer 只做薄壳，业务 UI 在 @answra/ui。",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "pnpm build:electron && concurrently -k \"vite --host 127.0.0.1 --port 5180 --strictPort\" \"wait-on http://127.0.0.1:5180 && electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "pnpm build:electron && vite build",
    "build:electron": "node ./scripts/build-electron.mjs",
    "audit:packaged": "node ./scripts/audit-packaged-input.mjs",
    "vad:prepare": "node ./scripts/prepare-ten-vad.mjs",
    "asr:prepare": "node ./scripts/prepare-asr.mjs",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "pnpm build && pnpm audit:packaged && electron-builder --win nsis",
    "icons": "node ./scripts/generate-icons.mjs"
  },
  "build": {
    "appId": "dev.answra.desktop",
    "productName": "Answra",
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "asarUnpack": [
      "**/node_modules/sherpa-onnx-node/**",
      "**/node_modules/sherpa-onnx-win-*/**",
      "**/node_modules/sherpa-onnx-darwin-*/**",
      "**/node_modules/sherpa-onnx-linux-*/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/vad",
        "to": "vad",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "Answra-${arch}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://answra-1307496114.cos.ap-chengdu.myqcloud.com/download/latest/"
    },
    "protocols": [
      {
        "name": "Answra",
        "schemes": [
          "answra"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Answra-Setup-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@answra/shared": "workspace:*",
    "@answra/ui": "workspace:*",
    "electron-updater": "^6.6.4",
    "koffi": "^3.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@answra/agent": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cos-nodejs-sdk-v5": "^2.14.5",
    "electron": "29.4.6",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.2",
    "png2icons": "^2.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
